# Used by the current Next.js recommendation route. Leave blank locally until set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# This demo calls the locally authenticated Google Workspace CLI.
# Do not add OAuth client secrets, access tokens, refresh tokens, or Gmail addresses here.
#
# Setup is documented in docs/gmail-mediation-demo.md. The default command is `gws`.
GWS_COMMAND=gws
